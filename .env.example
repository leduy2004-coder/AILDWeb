# Copy to BOTH .env and .env.production on the server.
# NEXT_PUBLIC_* are baked into the build, so rebuild the image after changing them.

# API is served under /api on the student domain (Nginx)
NEXT_PUBLIC_API_ENDPOINT=https://aild.io.vn
NEXT_PUBLIC_GOOGLE_LOGIN_URL=https://aild.io.vn/api/v1/auth/oauth2/authorization/google

# Separate portals: admin pages/login only on ADMIN_URL, student pages/login only on STUDENT_URL.
# Leave both empty to serve everything on one domain (e.g. http://<VPS_IP> or local dev).
NEXT_PUBLIC_STUDENT_URL=https://aild.io.vn
NEXT_PUBLIC_ADMIN_URL=https://admin.aild.io.vn
