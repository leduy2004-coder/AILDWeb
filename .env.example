# Copy to BOTH .env and .env.production on the server.
# NEXT_PUBLIC_* are baked into the build, so rebuild the image after changing them.

# No domain yet (Nginx serves web + API on one origin): http://<VPS_IP>
# With a domain later: https://aild.example.com
NEXT_PUBLIC_API_ENDPOINT=http://<VPS_IP>
NEXT_PUBLIC_GOOGLE_LOGIN_URL=http://<VPS_IP>/api/v1/auth/oauth2/authorization/google
